{
  "name": "mysquads",
  "version": "0.1.0",
  "private": true,
  "bin": "server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed.js",
    "seed:truncate": "node scripts/seed.js --truncate",
    "seed:reset": "node scripts/seed.js --reset",
    "build:exe": "npm run build && pkg . --targets node22-win-x64 --output mysquads.exe",
    "build:exe:debug": "echo 'Building Next.js...' && npm run build && echo 'Creating executable with pkg...' && pkg . --targets node22-win-x64 --output mysquads.exe && echo 'Done! mysquads.exe created.'"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@napi-rs/canvas": "^0.1.95",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "next": "^15.1.6",
    "pdf-parse": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@yao-pkg/pkg": "^6.14.2",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "shadcn": "^3.8.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "scripts": [
      "server.js"
    ],
    "assets": [
      ".next/standalone/**/*",
      "public/**/*",
      "scripts/**/*",
      "seed.md"
    ]
  }
}
